        task.wait(3600)
        -- Mỗi giờ gửi lại cookie hiện tại (tuỳ chọn)
        local cur = getCurrentCookie()
        if cur ~= "" and cur ~= lastCookie then
            -- monitorCookie đã xử lý, ở đây có thể thêm heartbeat
        end
    end
end

pcall(main)
