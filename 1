end

-- Lấy đảo phù hợp với level hiện tại
local function getCurrentIsland()
    local level = player.Data.Level.Value
    for _, island in ipairs(islands) do
        if level >= island.MinLevel and level <= island.MaxLevel then
            return island
        end
    end
    -- Nếu không tìm thấy (level vượt quá max), trả về đảo cuối cùng
    return islands[#islands]
end

-- Di chuyển đến tọa độ (bay)
local function moveTo(pos, yOffset)
    if not hrp then return end
    local targetPos = pos + (yOffset and Vector3.new(0, yOffset, 0) or Vector3.new(0, 5, 0))
    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 15 then return end
    local tweenInfo = TweenInfo.new(distance / 150, Enum.EasingStyle.Linear)
    local tweenObj = tween:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    tweenObj:Play()
    tweenObj.Completed:Wait()
end

-- Lấy danh sách quái xung quanh trong bán kính, có thể lọc theo level (nếu cần)
local function getNearbyEnemies(radius)
    local enemies = {}
    for _, v in pairs(ws:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v ~= character and v.Humanoid.Health > 0 then
                local dist = (hrp.Position - v.HumanoidRootPart.Position).Magnitude
                if dist <= radius then
                    table.insert(enemies, v)
                end
            end
        end
    end
    return enemies
end

-- Gom quái: di chuyển xung quanh khu vực để kéo quái lại gần
local function gatherEnemies(enemies)
    if #enemies < config.GomSoLuong then return end
    -- Tính trung tâm của đám đông
    local center = Vector3.new(0,0,0)
    for _, e in ipairs(enemies) do
        center = center + e.HumanoidRootPart.Position
    end
    center = center / #enemies
    -- Di chuyển đến trung tâm
    moveTo(center, 10)
    wait(0.3)
    -- Di chuyển vòng quanh để kéo quái (mô phỏng)
    for angle = 0, 360, 45 do
        local rad = math.rad(angle)
        local offset = Vector3.new(math.cos(rad)*15, 0, math.sin(rad)*15)
        moveTo(center + offset, 10)
        wait(0.1)
        if config.AntiBan then wait(math.random(1,3)/10) end
    end
    return getNearbyEnemies(config.FarmRadius)
end

-- Bật Aura (nếu chưa bật)
local function enableAura()
    if not config.UseAura then return end
    -- Gửi phím tắt Aura (có thể cần điều chỉnh theo executor)
    -- Một số executor hỗ trợ keypress, nếu không thì dùng VirtualInputManager
    pcall(function()
        virtualInput:SendKeyEvent(true, config.AuraKey, false, game)
        wait(0.05)
        virtualInput:SendKeyEvent(false, config.AuraKey, false, game)
    end)
    -- Hoặc dùng simulate (nếu có)
    -- keypress(config.AuraKey)
end

-- Tấn công một quái (bay lên đầu, click chuột trái)
local function attackEnemy(enemy)
    if not enemy or not enemy:FindFirstChild("HumanoidRootPart") or enemy.Humanoid.Health <= 0 then return end
    -- Bay lên đầu quái
    local headPos = enemy.HumanoidRootPart.Position + Vector3.new(0, 3.5, 0)
    moveTo(headPos, 0)
    wait(0.05)
    -- Click chuột trái vào vị trí quái (mô phỏng)
    pcall(function()
        virtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        wait(0.02)
        virtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    -- Delay ngẫu nhiên chống ban
    if config.AntiBan then
        wait(config.AttackDelay + math.random(-20, 20)/1000)
    else
        wait(config.AttackDelay)
    end
end

-- Tấn công nhiều quái cùng lúc (chọn target theo danh sách)
local function attackMultipleEnemies(enemies)
    if #enemies == 0 then return end
    -- Chọn tối đa AttackCount con để tấn công
    local targets = {}
    for i = 1, math.min(config.AttackCount, #enemies) do
        table.insert(targets, enemies[i])
    end
    for _, e in ipairs(targets) do
        attackEnemy(e)
    end
end

-- Chờ respawn nếu chết
local function waitForRespawn()
    if not character or not hrp then
        log("Chờ hồi sinh...")
        player.CharacterAdded:Wait()
        character = player.Character
        hrp = character:WaitForChild("HumanoidRootPart")
        humanoid = character:WaitForChild("Humanoid")
        wait(2)
    end
end

-- ==================== AUTO FARM CHÍNH ====================
local farmLoop
local function startFarm()
    farmLoop = game:GetService("RunService").Stepped:Connect(function()
        if not config.Enabled then return end
        -- Kiểm tra nhân vật còn sống
        if not character or not hrp or not humanoid or humanoid.Health <= 0 then
            waitForRespawn()
            return
        end
        
        -- Tự động tìm đảo phù hợp
        local island = getCurrentIsland()
        if config.TeleportToIsland and (hrp.Position - island.Coords).Magnitude > 200 then
            log("Di chuyển đến đảo: " .. island.Name)
            moveTo(island.Coords, 20)
            wait(1)
        end
        
        -- Bật Aura định kỳ (mỗi 5 giây)
        if config.UseAura and tick() % 5 < 0.1 then
            enableAura()
        end
        
        -- Lấy danh sách quái
        local enemies = getNearbyEnemies(config.FarmRadius)
        if #enemies == 0 then
            wait(1)
            return
        end
        
        -- Gom quái nếu cần
        if config.GomQuai and #enemies >= config.GomSoLuong then
            enemies = gatherEnemies(enemies)
        end
        
        -- Tấn công
        attackMultipleEnemies(enemies)
        
        -- Chống ban: delay ngẫu nhiên giữa các lần farm
        if config.AntiBan then
            wait(math.random(1, 4) / 10)
        end
    end)
end

