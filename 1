-- Hàm tạo Laser
function CreateLaser()
    if LaserPart then LaserPart:Destroy() end
    LaserPart = Instance.new("Part")
    LaserPart.Name = "AimLaser"
    LaserPart.BrickColor = BrickColor.new("Bright red")
    LaserPart.Material = Enum.Material.Neon
    LaserPart.Anchored = true
    LaserPart.CanCollide = false
    LaserPart.Transparency = 0.2
    LaserPart.Size = Vector3.new(0.2, 0.2, 1)
    LaserPart.Parent = Workspace
    -- Cập nhật laser mỗi frame
    local laserConnection = RunService.Heartbeat:Connect(function()
        if not AimSettings.Enabled or not AimSettings.ShowLaser then
            if LaserPart then LaserPart:Destroy(); LaserPart = nil end
            laserConnection:Disconnect()
            return
        end
        local root = GetRootPart()
        local target = CurrentTarget
        if root and target then
            local startPos = root.Position
            local endPos = target.Position
            local mid = (startPos + endPos) / 2
            local distance = (startPos - endPos).Magnitude
            LaserPart.Size = Vector3.new(0.2, 0.2, distance)
            LaserPart.CFrame = CFrame.new(mid, endPos) * CFrame.Angles(math.rad(90), 0, 0)
            LaserPart.Transparency = 0.2
        else
            if LaserPart then LaserPart.Transparency = 1 end
        end
    end)
end

-- Hàm cập nhật hitbox (cho Aim)
function UpdateHitboxes()
    -- Reset hitboxes cũ
    ResetAllHitboxes()
    -- Áp dụng multiplier cho tất cả kẻ địch
    local mult = AimSettings.HitboxMultiplier
    if mult <= 1 then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    local originalSize = part:GetAttribute("OriginalSize")
                    if not originalSize then
                        part:SetAttribute("OriginalSize", part.Size)
                    else
                        part.Size = originalSize * mult
                    end
                    table.insert(HitboxTargets, part)
                end
            end
        end
    end
end

function ResetAllHitboxes()
    for _, part in ipairs(HitboxTargets) do
        if part and part.Parent then
            local orig = part:GetAttribute("OriginalSize")
            if orig then
                part.Size = orig
            end
        end
    end
    HitboxTargets = {}
end

-- Hàm kết hợp laser + hitbox
function UpdateLaserAndHitbox()
    if HitboxConnection then HitboxConnection:Disconnect() end
    HitboxConnection = RunService.Heartbeat:Connect(function()
        if AimSettings.Enabled then
            UpdateHitboxes()
            if AimSettings.ShowLaser then
                if not LaserPart then CreateLaser() end
            else
                if LaserPart then LaserPart:Destroy(); LaserPart = nil end
            end
        else
            ResetAllHitboxes()
            if LaserPart then LaserPart:Destroy(); LaserPart = nil end
        end
    end)
end

