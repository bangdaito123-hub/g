-- Hàm tạo hitbox cho một người chơi
local function CreateHitboxForPlayer(player)
    if player == LocalPlayer then return end
    if not player.Character then return end
    local char = player.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    -- Xóa hitbox cũ nếu có
    if HitboxParts[player] then
        HitboxParts[player]:Destroy()
        HitboxParts[player] = nil
    end
    local part = Instance.new("Part")
    part.Name = "HitboxDisplay"
    part.BrickColor = BrickColor.new(HitboxSettings.Color)
    part.Material = Enum.Material.Neon
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = HitboxSettings.Transparency
    part.Size = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
    part.Parent = Workspace
    -- Cập nhật vị trí theo root của người chơi
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not HitboxSettings.Enabled or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            if part then part:Destroy() end
            if connection then connection:Disconnect() end
            HitboxParts[player] = nil
            return
        end
        local targetRoot = player.Character.HumanoidRootPart
        if not targetRoot then return end
        -- Nếu chỉ hiển thị khi còn sống
        local hum = player.Character:FindFirstChild("Humanoid")
        if HitboxSettings.OnlyAlive and hum and hum.Health <= 0 then
            part.Transparency = 1
        else
            part.Transparency = HitboxSettings.Transparency
        end
        part.CFrame = targetRoot.CFrame
        -- Cập nhật màu
        part.Color = HitboxSettings.Color
    end)
    HitboxParts[player] = part
    -- Lưu connection để cleanup
    part:SetAttribute("Connection", connection)
end

-- Hàm tạo tất cả hitbox
local function CreateAllHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        CreateHitboxForPlayer(player)
    end
end

-- Hàm cập nhật tất cả hitbox (khi có thay đổi)
local function UpdateAllHitboxes()
    -- Xóa hitbox của người chơi không còn tồn tại hoặc đã rời
    for player, part in pairs(HitboxParts) do
        if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            if part then part:Destroy() end
            HitboxParts[player] = nil
        end
    end
    -- Tạo mới cho người chơi chưa có
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if not HitboxParts[player] then
                CreateHitboxForPlayer(player)
            end
        end
    end
end

-- Hàm hủy tất cả hitbox
local function DestroyAllHitboxes()
    for player, part in pairs(HitboxParts) do
        if part then
            local conn = part:GetAttribute("Connection")
            if conn then conn:Disconnect() end
            part:Destroy()
        end
    end
    HitboxParts = {}
end

