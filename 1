-- Biến điều khiển
local AimSettings = {
    Enabled = false,
    Smoothness = 0.3,
    ShowLaser = false,
    HitboxMultiplier = 1.0,
    TargetPart = "Head"  -- Head, HumanoidRootPart, Torso
}
local CurrentTarget = nil
local LaserPart = nil
local AimConnection = nil
