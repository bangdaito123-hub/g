local KillAuraSettings = {
    Enabled = false,
    Range = 30,
    AttackSpeed = 0.5,   -- giây
    WeaponType = "Melee", -- Melee, Gun, Sword
    DamageMultiplier = 1.0,
    AutoRotate = true,
    TargetPart = "HumanoidRootPart",
}
local KillAuraConnection = nil
local KillAuraThread = nil
local KillAuraTarget = nil

-- Toggle Kill Aura
HitboxTab:CreateToggle({
    Name = "Bật Kill Aura (tự động tấn công)",
    CurrentValue = false,
    Flag = "KillAura",
    Callback = function(State)
        KillAuraSettings.Enabled = State
        if State then
            if KillAuraThread then task.cancel(KillAuraThread) end
            KillAuraThread = task.spawn(function()
                while KillAuraSettings.Enabled do
                    pcall(function()
                        local root = GetRootPart()
                        if not root then task.wait(0.5) return end
                        local target = nil
                        local minDist = KillAuraSettings.Range
                        for _, player in ipairs(Players:GetPlayers()) do
                            if player ~= LocalPlayer and player.Character then
                                local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
                                local hum = player.Character:FindFirstChild("Humanoid")
                                if targetRoot and hum and hum.Health > 0 then
                                    local dist = (root.Position - targetRoot.Position).Magnitude
                                    if dist < minDist then
                                        target = player.Character
                                        minDist = dist
                                    end
                                end
                            end
                        end
                        if target then
                            KillAuraTarget = target
                            -- Xoay về mục tiêu
                            if KillAuraSettings.AutoRotate then
                                local targetRoot = target:FindFirstChild("HumanoidRootPart")
                                if targetRoot then
                                    root.CFrame = CFrame.new(root.Position, targetRoot.Position)
                                end
                            end
                            -- Tấn công
                            local weapon = KillAuraSettings.WeaponType
                            if weapon == "Melee" then
                                VirtualUser:ClickButton1()
                            elseif weapon == "Gun" then
                                VirtualUser:ClickButton1() -- có thể là phím Q hoặc click
                            elseif weapon == "Sword" then
                                VirtualUser:ClickButton1()
                            end
                            -- Tùy chỉnh sát thương (nếu có thể)
                            local hum = target:FindFirstChild("Humanoid")
                            if hum and KillAuraSettings.DamageMultiplier ~= 1 then
                                -- Giả sử game có biến damage, ta có thể nhân lên
                                -- Thực tế cần tìm cách can thiệp, ở đây ta chỉ giả lập bằng cách gây thêm sát thương
                                -- Ví dụ: nếu game dùng Humanoid.Health, ta giảm
                                -- Nhưng để an toàn, không thay đổi vì có thể không hợp lệ
                                -- Ta có thể tìm RemoteEvent để gửi
                            end
                        else
                            KillAuraTarget = nil
                        end
                    end)
                    task.wait(KillAuraSettings.AttackSpeed)
                end
            end)
        else
            if KillAuraThread then
                task.cancel(KillAuraThread)
                KillAuraThread = nil
            end
        end
    end
})

