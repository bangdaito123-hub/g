-- ==================== HÀM HỖ TRỢ ====================
local function log(msg)
    if config.Verbose then
        print("[Shadow Farm] " .. msg)
        if player and player.PlayerGui then
            -- Gửi thông báo lên chat (tùy chọn)
            -- player.Chat:Chat(msg)
        end
