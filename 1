-- Toggle bật/tắt Aim
AimTab:CreateToggle({
    Name = "Bật Aim (nâng cao)",
    CurrentValue = false,
    Flag = "AimAdvanced",
    Callback = function(State)
        AimSettings.Enabled = State
        if State then
            if AimConnection then AimConnection:Disconnect() end
            AimConnection = RunService.Heartbeat:Connect(function()
                if not AimSettings.Enabled then return end
                local root = GetRootPart()
                if not root then return end
                -- Tìm mục tiêu gần nhất
                local target = nil
                local minDist = 300
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        local tr = player.Character:FindFirstChild(AimSettings.TargetPart)
                        if not tr then tr = player.Character:FindFirstChild("HumanoidRootPart") end
                        local th = player.Character:FindFirstChild("Humanoid")
                        if tr and th and th.Health > 0 then
                            local dist = (root.Position - tr.Position).Magnitude
                            if dist < minDist then
                                target = tr
                                minDist = dist
                            end
                        end
                    end
                end
                CurrentTarget = target
                if target then
                    -- Smoothness: nội suy CFrame
                    local targetCF = CFrame.new(root.Position, target.Position)
                    local smooth = AimSettings.Smoothness
                    if smooth >= 1 then
                        root.CFrame = targetCF
                    else
                        local current = root.CFrame
                        local new = current:Lerp(targetCF, smooth)
                        root.CFrame = new
                    end
                end
            end)
            -- Bắt đầu cập nhật laser và hitbox
            UpdateLaserAndHitbox()
        else
            if AimConnection then AimConnection:Disconnect(); AimConnection = nil end
            if LaserPart then LaserPart:Destroy(); LaserPart = nil end
            -- Reset hitbox về kích thước cũ
            ResetAllHitboxes()
            if HitboxConnection then HitboxConnection:Disconnect(); HitboxConnection = nil end
        end
    end
})

